<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kk.pethome.order.mapper.AddressMapper">
    <resultMap id="addrMap" type="com.kk.pethome.order.pojo.UserAddress">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="recipient" property="recipient"/>
        <result column="phone" property="phone"/>
        <result column="address" property="address"/>
        <result column="is_default" property="isDefault"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <select id="findByUserId" resultMap="addrMap">
        SELECT * FROM t_user_address WHERE user_id = #{userId} ORDER BY is_default DESC, create_time DESC
    </select>

    <insert id="Add" useGeneratedKeys="true" keyColumn="id" keyProperty="id">
        INSERT INTO t_user_address(user_id, recipient, phone, address, is_default, create_time)
        VALUES(#{userId}, #{recipient}, #{phone}, #{address}, #{isDefault}, NOW())
    </insert>

    <update id="Update">
        UPDATE t_user_address SET recipient=#{recipient}, phone=#{phone}, address=#{address}, is_default=#{isDefault} WHERE id=#{id}
    </update>

    <update id="setDefault">
        UPDATE t_user_address SET is_default = CASE WHEN id = #{id} THEN 1 ELSE 0 END WHERE user_id = #{userId}
    </update>

    <delete id="Delete">DELETE FROM t_user_address WHERE id = #{id}</delete>
    <delete id="DeleteBatch">
        DELETE FROM t_user_address WHERE id IN
        <foreach collection="list" item="id" open="(" separator="," close=")">#{id}</foreach>
    </delete>

    <select id="lookAll" resultMap="addrMap">SELECT * FROM t_user_address</select>
    <select id="lookById" resultMap="addrMap">SELECT * FROM t_user_address WHERE id = #{id}</select>
    <select id="loadcount" resultType="int">SELECT count(*) FROM t_user_address</select>
    <select id="lookPage" resultMap="addrMap">SELECT * FROM t_user_address LIMIT #{currentPage},#{pageSize}</select>
</mapper>
