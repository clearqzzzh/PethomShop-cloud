<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.kk.pethome.system.mapper.PermissionMapper">
    <resultMap id="permissionMap" type="com.kk.pethome.system.pojo.permission">
        <id column="id" property="id"></id>
        <result column="sn" property="sn"></result>
        <result column="name" property="name"></result>
        <result column="descs" property="descs"></result>
        <result column="url" property="url"></result>
    </resultMap>
    <insert id="save">
        insert into t_permission(sn,name,descs,url) values(#{sn},#{name},#{descs},#{url})
    </insert>
    <select id="lookPage" resultType="com.kk.pethome.system.pojo.permission">
        select * from t_permission limit #{currentPage}, #{pageSize}
    </select>
    <select id="lookAll" resultMap="permissionMap">
        select * from t_permission
    </select>
    <select id="loadcount" resultType="java.lang.Integer">
        select count(*) from t_permission
    </select>
    <select id="loadBySn" resultType="com.kk.pethome.system.pojo.permission">
        select * from t_permission where sn=#{sn}
    </select>
    <select id="lookByEmployeeId" resultType="java.lang.String">
        SELECT
            p.sn psn
        FROM
            t_employee_role er
                LEFT JOIN t_role r ON er.role_id = r.id
                LEFT JOIN t_role_permission rp on r.id = rp.role_id
                LEFT JOIN t_permission p ON rp.permission_id = p.id
        WHERE
            er.employee_id = #{id}
    </select>

</mapper>