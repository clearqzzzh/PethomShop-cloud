<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kk.pethome.pay.mapper.DeadLetterMapper">

    <resultMap id="deadLetterMap" type="com.kk.pethome.pay.pojo.DeadLetter">
        <id column="id" property="id"/>
        <result column="topic" property="topic"/>
        <result column="message_body" property="messageBody"/>
        <result column="fail_reason" property="failReason"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyColumn="id" keyProperty="id">
        INSERT INTO t_mq_dead_letter(topic, message_body, fail_reason, create_time)
        VALUES(#{topic}, #{messageBody}, #{failReason}, #{createTime})
    </insert>

    <select id="lookAll" resultMap="deadLetterMap">
        SELECT * FROM t_mq_dead_letter ORDER BY create_time DESC
    </select>
    <select id="lookById" resultMap="deadLetterMap">
        SELECT * FROM t_mq_dead_letter WHERE id = #{id}
    </select>
    <select id="loadcount" resultType="java.lang.Integer">
        SELECT count(*) FROM t_mq_dead_letter
    </select>
    <select id="lookPage" resultMap="deadLetterMap">
        SELECT * FROM t_mq_dead_letter LIMIT #{currentPage}, #{pageSize}
    </select>
    <delete id="Delete">
        DELETE FROM t_mq_dead_letter WHERE id = #{id}
    </delete>
    <delete id="DeleteBatch">
        DELETE FROM t_mq_dead_letter WHERE id IN
        <foreach collection="list" item="id" open="(" separator="," close=")">#{id}</foreach>
    </delete>
</mapper>
