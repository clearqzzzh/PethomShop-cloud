<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.kk.pethome.system.mapper.MenuMapper">
    <resultMap id="menuMap" type="com.kk.pethome.system.pojo.Menu">
        <id column="id" property="id"></id>
        <result column="icon" property="icon"></result>
        <result column="name" property="name"></result>
        <result column="component" property="component"></result>
        <result column="url" property="url"></result>
        <result column="index" property="index"></result>
        <result column="parent_id" property="parentId"></result>
        <result column="intro" property="intro"></result>
    </resultMap>
    <select id="lookPage" resultType="com.kk.pethome.system.pojo.Menu">
        select * from t_menu limit #{currentPage}, #{pageSize}
    </select>
    <select id="lookAll" resultMap="menuMap">
        select * from t_menu
    </select>
    <select id="loadcount" resultType="java.lang.Integer">
        select count(*) from t_menu
    </select>
    <resultMap id="TreeMap" type="com.kk.pethome.system.pojo.Menu">
        <id column="pid" property="id"/>
        <result property="name" column="pname"/>
        <result property="icon" column="picon"/>
        <collection property="children" ofType="com.kk.pethome.system.pojo.Menu">
            <id column="id" property="id"></id>
            <result column="icon" property="icon"></result>
            <result column="name" property="name"></result>
            <result column="component" property="component"></result>
            <result column="url" property="url"></result>
            <result column="index" property="index"></result>
            <result column="parent_id" property="parentId"></result>
            <result column="intro" property="intro"></result>
        </collection>
    </resultMap>
    <select id="queryByEmpId" resultMap="TreeMap">
        SELECT
            pm.id pid, pm.name pname, pm.icon picon,m.*
        FROM
            t_employee_role er
                LEFT JOIN t_role r ON er.role_id = r.id
                LEFT JOIN t_role_menu rm ON r.id = rm.role_id
                LEFT JOIN t_menu m ON rm.menu_id = m.id
                LEFT JOIN t_menu pm on pm.id = m.parent_id
        WHERE
            er.employee_id = #{id}
    </select>


</mapper>