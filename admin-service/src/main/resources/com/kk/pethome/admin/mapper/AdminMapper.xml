<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kk.pethome.admin.mapper.AdminMapper">

    <resultMap id="adminMap" type="com.kk.pethome.admin.pojo.Admin">
        <id column="id" property="id"/>
        <result column="username" property="username"/>
        <result column="password" property="password"/>
        <result column="salt" property="salt"/>
        <result column="phone" property="phone"/>
        <result column="email" property="email"/>
        <result column="avatar" property="avatar"/>
        <result column="role" property="role"/>
        <result column="state" property="state"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="lookAll" resultMap="adminMap">
        SELECT * FROM t_admin ORDER BY create_time DESC
    </select>

    <select id="lookById" resultMap="adminMap">
        SELECT * FROM t_admin WHERE id = #{id}
    </select>

    <select id="loadcount" resultType="int">
        SELECT COUNT(*) FROM t_admin
    </select>

    <select id="lookPage" resultMap="adminMap">
        SELECT * FROM t_admin ORDER BY create_time DESC LIMIT #{start}, #{pageSize}
    </select>

    <insert id="Add" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO t_admin(username, password, salt, phone, email, avatar, role, state)
        VALUES(#{username}, #{password}, #{salt}, #{phone}, #{email}, #{avatar}, #{role}, #{state})
    </insert>

    <update id="Update">
        UPDATE t_admin SET username=#{username}, phone=#{phone}, email=#{email},
            avatar=#{avatar}, role=#{role}, state=#{state}, update_time=NOW()
        WHERE id=#{id}
    </update>

    <delete id="Delete">
        DELETE FROM t_admin WHERE id = #{id}
    </delete>

    <delete id="DeleteBatch">
        DELETE FROM t_admin WHERE id IN
        <foreach collection="list" item="id" open="(" separator="," close=")">#{id}</foreach>
    </delete>

    <select id="findByUsername" resultMap="adminMap">
        SELECT * FROM t_admin WHERE username = #{username}
    </select>

</mapper>
