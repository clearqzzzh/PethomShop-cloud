<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kk.pethome.order.mapper.CartMapper">
    <resultMap id="cartMap" type="com.kk.pethome.order.pojo.CartItem">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="product_id" property="productId"/>
        <result column="category" property="category"/>
        <result column="quantity" property="quantity"/>
        <result column="create_time" property="createTime"/>
        <result column="product_name" property="productName"/>
        <result column="product_price" property="productPrice"/>
        <result column="product_image" property="productImage"/>
    </resultMap>

    <!-- 查用户购物车 — 跨库 JOIN 商品表获取名称、价格、图片 -->
    <select id="findByUserId" resultMap="cartMap">
        SELECT c.id, c.user_id, c.product_id, c.category, c.quantity, c.create_time,
               p.name AS product_name, p.price AS product_price, p.image_url AS product_image
        FROM t_cart_item c
        LEFT JOIN pethome_product.t_product p ON c.product_id = p.id
        WHERE c.user_id = #{userId}
        ORDER BY c.create_time DESC
    </select>

    <select id="findByUserAndProduct" resultMap="cartMap">
        SELECT * FROM t_cart_item WHERE user_id = #{userId} AND product_id = #{productId}
    </select>

    <insert id="Add" useGeneratedKeys="true" keyColumn="id" keyProperty="id">
        INSERT INTO t_cart_item(user_id, product_id, category, quantity, create_time)
        VALUES(#{userId}, #{productId}, #{category}, #{quantity}, #{createTime})
    </insert>

    <update id="updateQuantity">
        UPDATE t_cart_item SET quantity = #{quantity} WHERE id = #{id}
    </update>

    <delete id="deleteByIds">
        DELETE FROM t_cart_item WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </delete>

    <delete id="clearByUserId">
        DELETE FROM t_cart_item WHERE user_id = #{userId}
    </delete>

    <!-- BaseMapper 占位 -->
    <select id="lookAll" resultMap="cartMap">SELECT * FROM t_cart_item</select>
    <select id="lookById" resultMap="cartMap">SELECT * FROM t_cart_item WHERE id = #{id}</select>
    <select id="loadcount" resultType="int">SELECT count(*) FROM t_cart_item</select>
    <select id="lookPage" resultMap="cartMap">SELECT * FROM t_cart_item LIMIT #{currentPage}, #{pageSize}</select>
    <delete id="Delete">DELETE FROM t_cart_item WHERE id = #{id}</delete>
    <delete id="DeleteBatch">
        DELETE FROM t_cart_item WHERE id IN
        <foreach collection="list" item="id" open="(" separator="," close=")">#{id}</foreach>
    </delete>
</mapper>
